{
  "name": "qa-suite-eduardo-cortes",
  "version": "1.0.0",
  "description": "Suite de pruebas API (JSONPlaceholder) y E2E (SauceDemo) con Playwright, Allure y GitHub Actions",
  "author": "Eduardo Cortés Javier",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-firefox",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:resumen": "node scripts/resumen-ejecucion.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.2.0",
    "typescript": "^5.7.0"
  }
}
